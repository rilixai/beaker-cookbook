# Required: the agent, the api_predictor pass, and any run that calls a model.
OPENAI_API_KEY=sk-...

# Optional: point the OpenAI client somewhere else (proxy, gateway).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: AppWorld root override (data + experiment outputs live under it).
# Equivalent to --output-dir; defaults to the current directory.
# APPWORLD_ROOT=.
