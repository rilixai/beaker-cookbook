# Copy to .env (auto-loaded by the CLI).

# Gated dataset: request access at https://huggingface.co/datasets/databricks/officeqa first.
HF_TOKEN=

# Only the key for your chosen --model is needed (LiteLLM model strings).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Where questions + corpus (~4.5 GB) are cached. Default: ~/.cache/officeqa/
# OFFICEQA_CACHE_DIR=
