# Copy to .env (auto-loaded by the CLI). Only the key for your chosen model is needed.
OPENAI_API_KEY=
# Native PI requires Chat Completions. Set this for your compatible gateway.
# OPENAI_BASE_URL=https://gateway.example/v1
# OpenRouter vendor/model names route through OpenRouter.
# OPENROUTER_API_KEY=
# For gateway models via --base-url, point --api-key-var at the right variable.
